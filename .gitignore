__pycache__/
*.pyc
.DS_Store
.env
.env.*
# 環境変数の一覧は残す（値は書かない）
!.env.example
# ops/up.sh・ops/down.sh の設定（deploy.env.example をコピーして書く）
deploy.env
# pip download の置き場（ops/up.sh の手順 4）
wheels/
lab/wanlab.clab.yml
*.rpm
# uv の仮想環境
.venv/

# 社内の証明書（docs/pipeline.md の「動かないとき」）
lab/snmpd/certs/*.crt
lab/snmpd/certs/*.pem

# Terraform（state はローカル。消すと Terraform が作ったものを見失うので、このリポジトリのフォルダごと残す）
.terraform/
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
*.tfvars
!*.tfvars.example
terraform/**/.build/
ops/logs/
*.part
# ops/up.sh の手順 5-3 で取る Spark の jar
jars/
# VS Code のワークスペース設定は各自の手元だけに置く
.vscode/
