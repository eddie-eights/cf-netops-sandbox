# ops/up.sh / ops/down.sh の設定の見本。cp deploy.env.example deploy.env で写して書く（deploy.env は gitignore 済み）。
# 全部任意。無い行は既定値で動く。同じ名前の環境変数が空でなければ、そちらがこのファイルより優先する（PHASE=2 ops/up.sh）。
# シェルとしては実行しない（$HOME や $(…) は展開せず、値の先頭の ~/ だけ読み替える）。値が空の行は書いていないのと同じ。
# ここに書くのは「どこまで作るか」と手元の環境のことだけ。アカウント ID や ARN や認証情報は書かない（README「deploy.env に書けるもの」）。

# どこまで作るか（1 か 2 か 3）
#   1  LLM + RAG で対話する。ecr + main（VPC / Web の EC2 / AgentCore Runtime / Knowledge Base）
#   2  フェーズ 1 に lab（containerlab の EC2）→ stream（Telegraf → MSK → 異常検知 → DynamoDB）→ analytics（Spark → S3 Tables ほか SINKS の格納先）と graph（Neptune）を足す
#   3  フェーズ 2 の上に workflow（Temporal on ECS Fargate のワーカー + AgentCore Gateway（MCP））。エージェントが異常の原因を調べて修復案を出し、
#      人が Web の「承認」タブで承認すると lab で直して確かめる。lab と stream が要るので SKIP_LAB / SKIP_STREAM は書けない
PHASE=1

# PHASE=2 で一部のルートを作らない（1 / 0 のほか true / false、yes / no でも書ける。ファイルの 1 をその回だけ打ち消すなら SKIP_GRAPH=0 ops/up.sh）
#SKIP_LAB=1          # lab を作らない。約 $0.09/h 下がる。stream は lab の Telegraf から流すので SKIP_STREAM=1 も要る（無いと止まる）
#SKIP_STREAM=1       # stream（MSK → detector → DynamoDB と S3 sink）を作らない。analytics も作らない。「異常一覧」は使えない。約 $0.46/h 下がる
#SKIP_ANALYTICS=1    # analytics（EMR Serverless の Spark と S3 Tables、SINKS の格納先）を作らない。約 $0.17/h 下がる
#SKIP_GRAPH=1        # graph（Neptune）を作らない。約 $0.14/h 下がる。「トポロジ」タブは静的データを出す

# stream の S3 sink（MSK Connect）を作らない（既定は作る）。約 $0.14/h 下がる。Confluent の zip が取れないときにも。ops/down.sh は state から読むので要らない
#CREATE_S3_SINK=0

# analytics の Spark の格納先（カンマ区切り。iceberg / opensearch / prometheus。既定 iceberg）。terraform/analytics の sinks に渡す
#   iceberg     全トピック → S3 Tables（Iceberg）の snmp_metrics。テーブルは無料
#   opensearch  traps（ログ）→ OpenSearch Serverless の TIMESERIES コレクション <prefix>-logs（VPC の中からだけ届く）。
#               OCU がフェーズ 1 の Knowledge Base のコレクションと共有されるか未確認。共有されなければ最大 +$0.33/h
#   prometheus  metrics → Amazon Managed Service for Prometheus のワークスペース <prefix>-metrics。aps のエンドポイント 2 本で +$0.03/h と取り込みのサンプル課金
#SINKS=iceberg

# コンテナイメージ（エージェント。PHASE=3 ではワーカーも）のタグ。既定 v1。agent/ や workflow/ を変えたら v2 などに書き換える（ECR のタグは上書きできない）
#IMAGE_TAG=

# terraform/main の kb_admin_principal_arn。既定は空（Terraform が今の認証情報から決める）
#ADMIN_ARN=

# terraform/main の vpc_cidr（社内と重なるとき）と client_cidr（DX / VPN 経由のとき）。既定は variables.tf の値
#VPC_CIDR=10.0.0.0/16
#CLIENT_CIDR=192.0.2.0/24

# 社内の SSL 検査の CA の PEM。OPENSEARCH_CACERT_FILE は terraform/main の opensearch_cacert_file（既定は AWS_CA_BUNDLE と同じ）、
# AWS_CA_BUNDLE は AWS CLI と terraform がそのまま読む
#OPENSEARCH_CACERT_FILE=~/certs/corp-ca.pem
#AWS_CA_BUNDLE=~/certs/corp-ca.pem

# Web への SSM ポートフォワーディングの PC 側のポート（既定 8080）。NO_PORTFORWARD=1 なら開かずに終わる
#LOCAL_PORT=8080
#NO_PORTFORWARD=1

# ops/down.sh で ECR（イメージ）を残すか。1 = 残す（翌朝の ops/up.sh がビルドを飛ばせる。保管料は月数円）、0 = 消す（既定）。ops/up.sh は見ない
#KEEP_ECR=0

# AWS CLI と terraform のプロファイル（aws login で入っているときに書く。既定は環境の AWS_PROFILE）
#AWS_PROFILE=
