# ops/up.sh / ops/down.sh の設定の見本。cp deploy.env.example deploy.env で写して書く（deploy.env は配布物には入っていない）。
#
# .env.example との違い: こちらは「**何を作るか**」の設定で、Terraform に渡る。
# .env.example は「**動いているプログラムが読む値**」（リージョン・表の名前・タイトルなど）で、AWS 上では Terraform が渡すので手で用意しない。
#
# **必須なのは OWNER（デプロイする人の名前）だけ**で、ほかは全部任意（無い行・値が空の行は下の「既定」のまま。既定は AGENT=1 だけを作る）。
# 各行の頭に「既定 …」を書いてある。行のコメントを外して値を変えたときだけ、そちらが使われる。
# 同じ名前の環境変数が空でなければ、そちらがこのファイルより優先する（PIPELINE=1 ops/up.sh）。
# シェルとしては実行しない（$HOME や $(…) は展開せず、値の先頭の ~/ だけ読み替える）。値が空の行は書いていないのと同じ。
# ここに書くのは「どの機能を作るか」と手元の環境のことだけ。アカウント ID や ARN や認証情報は書かない（docs/deploy.md）。

# OWNER = デプロイする人の名前。**必須**（書かないと ops/up.sh も ops/down.sh も先頭で止まる）。一番下の OWNER= の右に自分の名前を書く（見本の efukuda は下の説明のとおりの形）。
# 英小文字で始まる 14 文字までの英小文字・数字・ハイフン（ハイフンは連続させず末尾にも置かない）。
# 1 つの AWS アカウントを何人かで使うときに、自分の名前で自分のリソースを探せるようにするための値。
#   リソース名と SSM のパスと Project タグの接頭辞は、この名前から <owner>-nwc-poc になる（efukuda なら efukuda-nwc-poc）。
#   接頭辞はリソース名（efukuda-nwc-poc-vpc / efukuda-nwc-poc-agent …）、SSM のパス（/efukuda-nwc-poc/…）、Project タグ、
#   ECR のリポジトリ名、EC2 の systemd ユニット名に入る。owner タグには OWNER がそのまま入る。
#   AgentCore Runtime の名前だけはハイフンが使えないので、- を _ にした <接頭辞>_agent（efukuda → efukuda_nwc_poc_agent）になる。
#   14 文字なのは、接頭辞が OpenSearch Serverless の data access policy 名の 32 文字（一番長い接尾辞は <接頭辞>-logs-read の 10 文字）に収まる長さだから。
#   ハイフンの制限は ECR のリポジトリ名
# **作ったあとで変えない。**名前が変わったリソースを Terraform は「別のもの」と見るので、打ち直すと全部作り直しになる（先に ops/down.sh で消してから変える）。
# ops/down.sh も同じ deploy.env を読むので、ここを書き換えずに打てば消す相手は自動で揃う。
OWNER=

# どの機能を作るか（1 / 0。既定は AGENT=1 / PIPELINE=0 / WORKFLOW=0）。
# 土台（base/ecr + base/core: VPC / Web の EC2 / バケット / ロール。約 $0.05/h）は必ず作る。
# AGENT か lab か analytics を作るなら、共用のエンドポイント（ecr.api / ecr.dkr / logs。約 $0.08/h）も土台に作る（AGENT=0 PIPELINE=1 でも lab のイメージの取得と Spark のログが通る）。
# 機能は互いに独立で、要るものだけ 1 にする。あとから別の機能を 1 にして ops/up.sh を打ち直せば、その機能だけ足される（土台と他の機能は作り直さない）。
#   AGENT     agent での分析。AgentCore Runtime + ガードレール + bedrock のエンドポイント 3 本。Web の「チャット」タブが使える。約 $0.05/h（+ 質問ごとのモデル料金）
#   PIPELINE  データパイプライン。lab（containerlab の EC2 と Telegraf の EC2）→ stream（MSK）→ analytics（Spark → S3 Tables / OpenSearch / Prometheus。異常を検知して
#             DynamoDB と EventBridge に出す）と graph（Neptune）。Web の「トポロジ」「異常一覧」タブが動く。約 $1.51/h（SINK_* が既定のとき。SINK_OPENSEARCH=0 と SINK_PROMETHEUS=0 なら約 $1.15/h、SKIP_* でさらに減らせる）
#   WORKFLOW  Temporal での実行。workflow（Temporal on ECS Fargate のワーカー + AgentCore Gateway（MCP）+ EventBridge → SQS）。Spark の検知が SQS で届き、
#             エージェントが Neptune / OpenSearch / Prometheus を見て原因を調べて修復案を出し、人が Web の「承認」タブで承認すると Temporal が lab で直して確かめる。
#             AGENT と PIPELINE（lab / stream / analytics）が要るので、WORKFLOW=1 なら両方 1 にし、SKIP_LAB / SKIP_STREAM / SKIP_ANALYTICS は書けない。約 $0.06/h
AGENT=1
PIPELINE=0
WORKFLOW=0

# AGENT=1 で Knowledge Base（S3 の md → Titan Embeddings → OpenSearch Serverless）も作る。**既定 0 = 作らない**（エージェントはモデルとツールだけで答える）。
# 作ると +$0.33/h（OCU 1 つ、スタンバイ無し）+ bedrock-agent-runtime のエンドポイント +$0.03/h
#CREATE_KB=0

# PIPELINE=1 で一部のルートを作らない（**既定は 4 つとも 0 = 全部作る**。ファイルの 1 をその回だけ打ち消すなら SKIP_GRAPH=0 ops/up.sh）
#SKIP_LAB=1          # lab を作らない。約 $0.09/h 下がる。Telegraf の EC2 も lab が作り、機器へは lab の EC2 を通るので SKIP_STREAM=1 にする必要がある（しないと止まる）
#SKIP_STREAM=1       # stream（MSK と S3 sink）と Telegraf の EC2 を作らない。analytics も作らない。「異常一覧」は使えない。約 $1.28/h 下がる（SINK_* が既定のとき）
#SKIP_ANALYTICS=1    # analytics（EMR Serverless の Spark と SINK_* の格納先、異常検知）を作らない。「異常一覧」は使えない。約 $0.56/h 下がる（SINK_* が既定のとき）
#SKIP_GRAPH=1        # graph（Neptune）を作らない。約 $0.14/h 下がる。「トポロジ」タブはファイルで定義した静的データを出す

# stream の S3 sink（MSK Connect）を作らない（**既定 1 = 作る**）。約 $0.14/h 下がる。Confluent の zip が取れないときにも。ops/down.sh は state から読むので要らない
#CREATE_S3_SINK=0

# analytics の Spark の格納先を 1 つずつ作る / 作らない（1 / 0。既定は 3 つとも 1。0 にした格納先はリソースごと作らない。1 つ以上は要る）
#   OCU が Knowledge Base のコレクションと共有されなくても入れる（最大 +$0.33/h は承知のうえ）
#   SINK_S3          全トピック → S3 Tables（Iceberg）の snmp_metrics。テーブルは無料、s3tables のエンドポイント 2 本で +$0.03/h。
#                    stream の S3 sink（MSK Connect。上の CREATE_S3_SINK）とは別物
#   SINK_OPENSEARCH  traps と logs（ログ。logs は FRR のログ）→ OpenSearch Serverless の TIMESERIES コレクション <prefix>-logs（VPC の中からだけ届く）。
#                    OCU が Knowledge Base（CREATE_KB=1）のコレクションと共有されるか未確認。共有されなければ最大 +$0.33/h
#   SINK_PROMETHEUS  metrics → Amazon Managed Service for Prometheus のワークスペース <prefix>-metrics。aps のエンドポイント 2 本で +$0.03/h と取り込みのサンプル課金
#   0 にすると、エージェントの search_logs / query_metrics はその格納先が無いので「配備されていない」を返す。
#   前に 1 で作ったものを 0 にして ops/up.sh を打ち直すと、その格納先は消える（S3 Tables のテーブルの中身も）
#SINK_S3=1
#SINK_OPENSEARCH=1
#SINK_PROMETHEUS=1

# コンテナイメージ（エージェント。WORKFLOW=1 ではワーカーも）のタグ。**既定 v1**。
# agent/ や workflow/ を変えたら v2 などに書き換える（ECR のタグは上書きできない）。ECR にそのタグが無いときだけビルドして push する
#IMAGE_TAG=v1

# terraform/agent の kb_admin_principal_arn（CREATE_KB=1 のとき）。**既定は空**（Terraform が今の認証情報から決める）
#ADMIN_ARN=

# terraform/base/core の vpc_cidr（社内と重なるとき）と client_cidr（DX / VPN 経由のとき）。
# **既定は vpc_cidr=10.0.0.0/16 と client_cidr=空**（空なら社内 CIDR からエンドポイントを開けない）。下の CLIENT_CIDR は書き方の見本
#VPC_CIDR=10.0.0.0/16
#CLIENT_CIDR=192.0.2.0/24

# 社内の SSL 検査の CA の PEM。**どちらも既定は空**（検査が無い環境では要らない）。
# OPENSEARCH_CACERT_FILE は terraform/agent の opensearch_cacert_file（書かなければ AWS_CA_BUNDLE と同じ）、
# AWS_CA_BUNDLE は AWS CLI と terraform がそのまま読む。下の値は書き方の見本
#OPENSEARCH_CACERT_FILE=~/certs/corp-ca.pem
#AWS_CA_BUNDLE=~/certs/corp-ca.pem

# Web への SSM ポートフォワーディングの PC 側のポート（**既定 8080**）。NO_PORTFORWARD は**既定 0**で、1 なら開かずに終わる
#LOCAL_PORT=8080
#NO_PORTFORWARD=1

# ops/down.sh で ECR（イメージ）を残すか。1 = 残す（次回の ops/up.sh がビルドを飛ばせる。保管料は月数円）、**0 = 消す（既定）**。ops/up.sh は見ない
#KEEP_ECR=0

# terraform の出力。**既定 0** = Plan / できた（消えた）リソース / 5 分ごとの経過 / エラーだけを出し、
# 全文は ops/logs/tf-<ルート>-apply.log（destroy.log）に残す。1 = 全部そのまま出す
#TF_VERBOSE=0

# AWS CLI と terraform のプロファイル（aws login で入っているときに書く）。**既定は空 = 環境の AWS_PROFILE をそのまま使う**
#AWS_PROFILE=
