# ops/up.sh と ops/down.sh の設定。使うときはリポジトリの直下でコピーして書き換える:
#   cp deploy.env.example deploy.env
# deploy.env は .gitignore 済み（コミットされない）。無くても動く（そのときはフェーズ 1 を作る）。
#
# 書き方:
#   - 1 行に 1 つ「キー=値」。= の前後に空白を入れてもよい。シェルとしては実行しない（$HOME や $(…) は展開しない。先頭の ~/ だけ読み替える）
#   - # で始まる行と、値の後ろの「 # …」はコメント。値に # や空白を含めるときは "…" で囲む
#   - 値が空の行（`IMAGE_TAG=`）は書いていないのと同じ。使わないキーは行頭の # を外さない
#   - SKIP_LAB / SKIP_GRAPH / WITH_STREAM / NO_PORTFORWARD は 1 / 0 のほか true / false、yes / no でもよい（CREATE_S3_SINK と KEEP_ECR は 1 か 0 だけ）
#   - 同じ名前の環境変数が空でなければそちらが勝つ（`PHASE=2 ops/up.sh` はこのファイルの PHASE より優先）
#   - 知らないキー（打ち間違い）と、同じキーの 2 回目があると、何も作らずに止まる
# 別の場所のファイルを使うときは DEPLOY_ENV_FILE=<パス> ops/up.sh。
# 料金は東京リージョンの時間課金で、2026-09-14〜15 に確かめた単価（$1 = 150 円）。README「1 時間起動したときの試算」と同じ数字。

# ===== どこまで作るか =====
#
# PHASE=1（既定）: LLM + RAG の対話
#   ECR / 閉じた VPC と VPC エンドポイント / Web の EC2 / AgentCore Runtime / Bedrock ナレッジベース + OpenSearch Serverless / ガードレール。
#   Web のチャットで、S3 に置いた資料（RAG）を引いて答える。待機だけで約 $0.52/h（約 79 円/h）
#
# PHASE=2: フェーズ 1 + lab とトポロジの操作
#   lab   … containerlab の疑似トポロジを載せた EC2（t4g.large）。Session Manager で入り、sudo lab check / failover などで障害を起こして戻す
#   graph … Neptune。Web の「トポロジ」タブで機器とリンクを編集する
#   フェーズ 1 に約 $0.23/h（約 35 円/h）足される
#
# 組織の SCP や IAM で MSK / Neptune / t4g.large が拒否されていると、PHASE=2（と WITH_STREAM=1）は途中で止まる
# （エラーに explicitly denied / explicit deny と出る）。README「うまくいかないとき」。
PHASE=1

# --- PHASE=2 の中で外すもの（どちらも 1 = 作らない）---
# lab を作らない。約 $0.09/h 下がる。WITH_STREAM=1 とは一緒に使えない（stream は lab の Telegraf から流す）
#SKIP_LAB=1
# graph（Neptune）を作らない。約 $0.14/h 下がる。トポロジタブは組み込みの静的データを出す（編集はできない）
#SKIP_GRAPH=1

# --- PHASE=2 の任意 ---
# stream（MSK → S3 sink / 異常検知 Lambda → DynamoDB）を作り、Web の「異常一覧」を使う。lab が要る。
# 約 $0.29/h（約 44 円/h）足される。1 か月つけっぱなしで約 $213（約 32,000 円）。触った日のうちに ops/down.sh
#WITH_STREAM=1
# WITH_STREAM=1 のとき、MSK Connect の S3 sink を作らない（異常一覧は動く。S3 に生データが残らない）。stream が約 $0.15/h になる
#CREATE_S3_SINK=0

# ===== その他（書かなければ既定値）=====
# agent イメージのタグ。既定 v1。ECR にそのタグが無いときだけ docker buildx でビルドして push する（同じタグは上書きしない）
#IMAGE_TAG=
# OpenSearch Serverless とナレッジベースを管理する IAM の ARN（terraform/main の kb_admin_principal_arn）。
# 既定は空で、打った人の認証情報（IAM ユーザーか assumed-role）から決める。それ以外の形で ops/up.sh が止まったときだけ書く
#ADMIN_ARN=
# 作る VPC の CIDR（/16〜/24）。既定は terraform/main/variables.tf の vpc_cidr。社内のネットワークと重なるときだけ変える
#VPC_CIDR=
# DX / VPN 経由で社内 PC から ssm / ssmmessages のエンドポイントを呼ぶときの社内の CIDR。既定は空（使わない）
#CLIENT_CIDR=
# 社内の SSL 検査がある PC で、AWS CLI と terraform に渡す CA 証明書（PEM）のパス（README「社内 PC で使うとき」）
#AWS_CA_BUNDLE=
# OpenSearch Serverless へつなぐときだけ別の CA 証明書（PEM）を使うときのパス。既定は AWS_CA_BUNDLE と同じ
#OPENSEARCH_CACERT_FILE=
# 使う AWS CLI のプロファイル名。aws-vault の `exec <プロファイル> --no-session` の中で打つときは書かない
#AWS_PROFILE=
# Web をブラウザで開く手元のポート。既定 8080
#LOCAL_PORT=
# 1 = 最後のポートフォワーディングを張らずに終わる（利用者に配るコマンドは表示する）
#NO_PORTFORWARD=1
# ops/down.sh で ECR（イメージ）を残す。1 = 残す、0 = 消す（既定）。翌日の ops/up.sh でビルドを飛ばせる
#KEEP_ECR=1
