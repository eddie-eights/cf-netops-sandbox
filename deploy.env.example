# ops/up.sh / ops/down.sh の設定の見本。cp deploy.env.example deploy.env で写して書く（deploy.env は gitignore 済み）。
# 全部任意。無い行は既定値で動く。同じ名前の環境変数が空でなければ、そちらがこのファイルより優先する（PIPELINE=1 ops/up.sh）。
# シェルとしては実行しない（$HOME や $(…) は展開せず、値の先頭の ~/ だけ読み替える）。値が空の行は書いていないのと同じ。
# ここに書くのは「どの機能を作るか」と手元の環境のことだけ。アカウント ID や ARN や認証情報は書かない（README「deploy.env に書けるもの」）。

# どの機能を作るか（1 / 0）。土台（base/ecr + base/core: VPC / Web の EC2 / バケット / ロール。約 $0.05/h）は必ず作る。
# AGENT か lab か analytics を作るなら、共用のエンドポイント（ecr.api / ecr.dkr / logs。約 $0.08/h）も土台に作る（AGENT=0 PIPELINE=1 でも lab のイメージの取得と Spark のログが通る）。
# 機能は互いに独立で、要るものだけ 1 にする。あとから別の機能を 1 にして ops/up.sh を打ち直せば、その機能だけ足される（土台と他の機能は作り直さない）。
#   AGENT     agent での分析。AgentCore Runtime + ガードレール + bedrock のエンドポイント 3 本。Web の「チャット」タブが使える。約 $0.05/h（+ 質問ごとのモデル料金）
#   PIPELINE  データパイプライン。lab（containerlab の EC2）→ stream（Telegraf → MSK）→ analytics（Spark → S3 Tables / OpenSearch / Prometheus。異常を検知して
#             DynamoDB と EventBridge に出す）と graph（Neptune）。Web の「トポロジ」「異常一覧」タブが動く。約 $1.08/h（SINK_* が既定のとき。SINK_OPENSEARCH=0 と SINK_PROMETHEUS=0 なら約 $0.72/h、SKIP_* でさらに減らせる）
#   WORKFLOW  Temporal での実行。workflow（Temporal on ECS Fargate のワーカー + AgentCore Gateway（MCP）+ EventBridge → SQS）。Spark の検知が SQS で届き、
#             エージェントが Neptune / OpenSearch / Prometheus を見て原因を調べて修復案を出し、人が Web の「承認」タブで承認すると Temporal が lab で直して確かめる。
#             AGENT と PIPELINE（lab / stream / analytics）が要るので、WORKFLOW=1 なら両方 1 にし、SKIP_LAB / SKIP_STREAM / SKIP_ANALYTICS は書けない。約 $0.06/h
AGENT=1
PIPELINE=0
WORKFLOW=0

# AGENT=1 で Knowledge Base（S3 の md → Titan Embeddings → OpenSearch Serverless）も作る。既定は作らない（エージェントはモデルとツールだけで答える）。
# 作ると +$0.33/h（OCU 1 つ、スタンバイ無し）+ bedrock-agent-runtime のエンドポイント +$0.03/h
#CREATE_KB=0

# PIPELINE=1 で一部のルートを作らない（ファイルの 1 をその回だけ打ち消すなら SKIP_GRAPH=0 ops/up.sh）
#SKIP_LAB=1          # lab を作らない。約 $0.09/h 下がる。stream は lab の Telegraf から流すので SKIP_STREAM=1 にする必要がある（しないと止まる）
#SKIP_STREAM=1       # stream（Telegraf → MSK と S3 sink）を作らない。analytics も作らない。「異常一覧」は使えない。約 $0.84/h 下がる（SINK_* が既定のとき）
#SKIP_ANALYTICS=1    # analytics（EMR Serverless の Spark と SINK_* の格納先、異常検知）を作らない。「異常一覧」は使えない。約 $0.56/h 下がる（SINK_* が既定のとき）
#SKIP_GRAPH=1        # graph（Neptune）を作らない。約 $0.14/h 下がる。「トポロジ」タブはファイルで定義した静的データを出す

# stream の S3 sink（MSK Connect）を作らない（既定は作る）。約 $0.14/h 下がる。Confluent の zip が取れないときにも。ops/down.sh は state から読むので要らない
#CREATE_S3_SINK=0

# analytics の Spark の格納先を 1 つずつ作る / 作らない（1 / 0。既定は 3 つとも 1。0 にした格納先はリソースごと作らない。1 つ以上は要る）
#   OCU が Knowledge Base のコレクションと共有されなくても入れる（最大 +$0.33/h は承知のうえ）
#   SINK_S3          全トピック → S3 Tables（Iceberg）の snmp_metrics。テーブルは無料、s3tables のエンドポイント 2 本で +$0.03/h。
#                    stream の S3 sink（MSK Connect。上の CREATE_S3_SINK）とは別物
#   SINK_OPENSEARCH  traps と logs（ログ。logs は FRR のログ）→ OpenSearch Serverless の TIMESERIES コレクション <prefix>-logs（VPC の中からだけ届く）。
#                    OCU が Knowledge Base（CREATE_KB=1）のコレクションと共有されるか未確認。共有されなければ最大 +$0.33/h
#   SINK_PROMETHEUS  metrics → Amazon Managed Service for Prometheus のワークスペース <prefix>-metrics。aps のエンドポイント 2 本で +$0.03/h と取り込みのサンプル課金
#   0 にすると、エージェントの search_logs / query_metrics はその格納先が無いので「配備されていない」を返す。
#   前に 1 で作ったものを 0 にして ops/up.sh を打ち直すと、その格納先は消える（S3 Tables のテーブルの中身も）
#SINK_S3=1
#SINK_OPENSEARCH=1
#SINK_PROMETHEUS=1

# コンテナイメージ（エージェント。WORKFLOW=1 ではワーカーも）のタグ。既定 v1。agent/ や workflow/ を変えたら v2 などに書き換える（ECR のタグは上書きできない）
#IMAGE_TAG=

# terraform/agent の kb_admin_principal_arn（CREATE_KB=1 のとき）。既定は空（Terraform が今の認証情報から決める）
#ADMIN_ARN=

# terraform/base/core の vpc_cidr（社内と重なるとき）と client_cidr（DX / VPN 経由のとき）。既定は variables.tf の値
#VPC_CIDR=10.0.0.0/16
#CLIENT_CIDR=192.0.2.0/24

# 社内の SSL 検査の CA の PEM。OPENSEARCH_CACERT_FILE は terraform/agent の opensearch_cacert_file（既定は AWS_CA_BUNDLE と同じ）、
# AWS_CA_BUNDLE は AWS CLI と terraform がそのまま読む
#OPENSEARCH_CACERT_FILE=~/certs/corp-ca.pem
#AWS_CA_BUNDLE=~/certs/corp-ca.pem

# Web への SSM ポートフォワーディングの PC 側のポート（既定 8080）。NO_PORTFORWARD=1 なら開かずに終わる
#LOCAL_PORT=8080
#NO_PORTFORWARD=1

# ops/down.sh で ECR（イメージ）を残すか。1 = 残す（次回の ops/up.sh がビルドを飛ばせる。保管料は月数円）、0 = 消す（既定）。ops/up.sh は見ない
#KEEP_ECR=0

# terraform の出力。既定は Plan / できた（消えた）リソース / 5 分ごとの経過 / エラーだけを出し、全文は ops/logs/tf-<ルート>-apply.log（destroy.log）に残す。
# 1 = 全部そのまま出す
#TF_VERBOSE=0

# AWS CLI と terraform のプロファイル（aws login で入っているときに書く。既定は環境の AWS_PROFILE）
#AWS_PROFILE=
