# ops/up.sh と ops/down.sh の設定。cp deploy.env.example deploy.env で写し、必要な行の先頭の # を外して書く。
# deploy.env は gitignore 済み（自分の値を書いてよい）。1 行に 1 つの「キー=値」だけ。# より後ろはコメント。
# $HOME や $(…) は展開しない。値の先頭の ~/ だけ $HOME/ に読み替える。
# 同じ名前の環境変数が空でなければ、ファイルの値は使わない（PHASE=2 ops/up.sh のように環境変数が先）。
# ファイルの 1 を環境変数で打ち消すときは空ではなく 0 を渡す（SKIP_GRAPH=0 ops/up.sh）。
# 知らないキーと、同じキーの 2 回目は止まる。読み方の細かい規則は ops/deploy-env.sh の先頭。
#
# フェーズ（docs/phases.md）:
#   1  LLM + RAG の対話（ecr / main。既定）
#   2  1 に加えて、containerlab → Telegraf → Kafka → Spark → S3 Tables のデータパイプラインと、トポロジの Neptune
#      （lab / stream / analytics / graph）
#   3  Temporal でエージェントが原因を調査し、人が修復を承認するまで。まだ Terraform が無いので ops/up.sh は止まる
# 2B / 5A / 5B は 2026-09-17 に無くなった番号（2B → 2、5A + 5B → 3）。書くと止まる。

# ---- どこまで作るか --------------------------------------------------------------
PHASE=1

# PHASE=2 のときだけ効く。1 で該当のルートを作らない（PHASE=1 は全部 1 と同じ）。
# stream は lab の SNMP を読み、analytics は stream の Kafka を読むので、
#   SKIP_LAB=1 なら SKIP_STREAM=1 も書く（書かないと止まる）
#   SKIP_STREAM=1 なら analytics も作らない（自動で SKIP_ANALYTICS=1 になる）
#SKIP_LAB=1         # lab（containerlab の EC2）を作らない。約 $0.09/h 下がる
#SKIP_STREAM=1      # stream（MSK / Telegraf / DynamoDB）と analytics を作らない。約 $0.46/h 下がる
#SKIP_ANALYTICS=1   # analytics（EMR Serverless の Spark / S3 Tables）を作らない。約 $0.17/h 下がる
#SKIP_GRAPH=1       # graph（Neptune）を作らない。約 $0.14/h 下がる

# stream の S3 sink（MSK Connect。Kafka のメッセージを S3 にも残す）。1 = 作る（既定）、0 = 作らない（約 $0.14/h 下がる。
# 履歴の正本は analytics の S3 Tables なので、0 でもデータは残る）
#CREATE_S3_SINK=1

# ---- イメージ ----------------------------------------------------------------------
# エージェントのイメージのタグ。既定 v1。ECR にそのタグが無いときだけ PC（WSL）の docker buildx でビルドして push する（タグは上書きできない）
#IMAGE_TAG=v1

# ---- ネットワークと権限 -----------------------------------------------------------------
# terraform/main の kb_admin_principal_arn（OpenSearch Serverless のデータアクセスに足す自分の IAM の ARN）。
# 既定は空（Terraform が今の認証情報から決める）。aws-vault や assume role で ARN が変わる人だけ書く
#ADMIN_ARN=

# terraform/main の vpc_cidr（既定 10.0.0.0/16。社内と重なるとき）と client_cidr（既定は空。DX / VPN 経由で Web を開くとき）
#VPC_CIDR=10.0.0.0/16
#CLIENT_CIDR=

# ---- 社内 PC（SSL 検査）で使うとき ------------------------------------------------------
# 社内の SSL 検査の CA の PEM（README「社内 PC で使うとき」）。AWS_CA_BUNDLE は aws CLI と terraform が読む。
# OPENSEARCH_CACERT_FILE は terraform/main の opensearch_cacert_file で、既定は AWS_CA_BUNDLE と同じ
#OPENSEARCH_CACERT_FILE=~/certs/corp-ca.pem
#AWS_CA_BUNDLE=~/certs/corp-ca.pem

# ---- 手元の Web への接続 ---------------------------------------------------------------
# ops/up.sh の最後に打つ SSM のポートフォワードの手元のポートと、それを打たない（1）か
#LOCAL_PORT=8080
#NO_PORTFORWARD=1

# ---- ops/down.sh だけが読む -------------------------------------------------------------
# ECR（イメージ）を残す（1）か消す（0。既定）か。残せば翌日の ops/up.sh でビルドを飛ばせる（保管料は月数円）
#KEEP_ECR=0

# ---- AWS の認証 -------------------------------------------------------------------------
# aws login / aws configure sso で作ったプロファイル名。aws-vault のサブシェルで打つなら書かない
#AWS_PROFILE=
