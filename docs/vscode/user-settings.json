// VS Code のユーザー設定の例。
// 入れ方: VS Code で Ctrl+Shift+P →「基本設定: ユーザー設定を開く (JSON)」→ この中身を貼る。
// 既に設定があるなら、丸ごと上書きせず要るところだけ足す。
//
// あえて入れていない設定（要るなら自分で足す。理由は docs/development.md「VS Code（任意）」）:
//   claudeCode.allowDangerouslySkipPermissions / security.workspace.trust.untrustedFiles
//   security.promptForLocalFileProtocolHandling / claudeCode.claudeProcessWrapper
{
  // 見た目
  // テーマ本体は拡張。入っていなければ既定のテーマになるだけで、壊れはしない
  "workbench.colorTheme": "One Dark Modern Classic",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.colorCustomizations": {
    "tab.activeBackground": "#a35d23",
    "tab.activeForeground": "#e2cfbe",
    "tab.unfocusedActiveBackground": "#565656",
    "tab.unfocusedActiveForeground": "#cbc3c3"
  },
  "workbench.sideBar.location": "right",
  "workbench.startupEditor": "none",
  "editor.minimap.enabled": false,
  "editor.accessibilitySupport": "off",

  // Git
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.openRepositoryInParentFolders": "never",

  // エクスプローラー（確認ダイアログを消す）
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmPasteNative": false,

  // Python / Jupyter
  "python.analysis.typeCheckingMode": "basic",
  "jupyter.askForKernelRestart": false,

  // JSON スキーマの取得を許可する先
  "json.schemaDownload.trustedDomains": {
    "https://schemastore.azurewebsites.net/": true,
    "https://raw.githubusercontent.com/microsoft/vscode/": true,
    "https://raw.githubusercontent.com/devcontainers/spec/": true,
    "https://www.schemastore.org/": true,
    "https://json.schemastore.org/": true,
    "https://json-schema.org/": true,
    "https://developer.microsoft.com/json-schemas/": true,
    "https://biomejs.dev": true
  },

  // AI 系の拡張向け（拡張が入っていなければ無視されるだけ）
  "chat.disableAIFeatures": true,
  "chat.instructionsFilesLocations": {
    ".github/instructions": true
  },
  "chat.viewSessions.orientation": "stacked",
  "github.copilot.nextEditSuggestions.enabled": true,
  "claudeCode.preferredLocation": "panel",
  "claudeCode.hideOnboarding": true,
  "claudeCodeChat.thinking.intensity": "ultrathink",
  "chatgpt.localeOverride": "ja-JP",
  "chatgpt.composerEnterBehavior": "enter",
  "chatgpt.followUpQueueMode": "steer",

  // その他
  "update.showReleaseNotes": false,
  "makefile.configureOnOpen": true
}
