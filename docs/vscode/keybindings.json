// ターミナルで Shift+Enter を改行にするキー割り当て。
// 入れ方: VS Code で Ctrl+Shift+P →「基本設定: キーボードショートカットを開く (JSON)」→ この中身を貼る。
[
  {
    // ターミナルで Shift+Enter を改行として送る（Claude Code などの複数行入力用）。送っているのは ESC + CR。
    "key": "shift+enter",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      "text": "\u001b\r"
    },
    "when": "terminalFocus"
  }
]
