Content-Type: multipart/mixed; boundary="==BOUNDARY=="
MIME-Version: 1.0

--==BOUNDARY==
Content-Type: text/cloud-config; charset="us-ascii"
MIME-Version: 1.0

#cloud-config
cloud_final_modules:
- [scripts-user, always]

--==BOUNDARY==
Content-Type: text/x-shellscript; charset="utf-8"
MIME-Version: 1.0
Content-Transfer-Encoding: 8bit

#!/bin/bash
# 支度の中身は S3 の lab/setup.sh（cloudformation/lab-debug.yaml の UserData と共通）。ここは env を書いて置き直し、呼ぶだけ
set -euo pipefail
LAB=/opt/${name_prefix}-lab
install -d -m 0755 $LAB
cat > /etc/${name_prefix}-lab.env <<'__ENV__'
NAME_PREFIX=${name_prefix}
AWS_REGION=${region}
REGISTRY=${account_id}.dkr.ecr.${region}.amazonaws.com
SRLINUX_IMAGE=${account_id}.dkr.ecr.${region}.amazonaws.com/${name_prefix}-lab-srlinux:${srlinux_image_tag}
MULTITOOL_IMAGE=${account_id}.dkr.ecr.${region}.amazonaws.com/${name_prefix}-lab-multitool:${multitool_image_tag}
TELEGRAF_IMAGE=
PARAM_PREFIX=/${name_prefix}
CONTAINERLAB_VERSION=${containerlab_version}
AUTO_START_LAB=${auto_start_lab}
__ENV__
aws s3 sync --delete --region ${region} s3://${bucket}/lab/ $LAB/src/
if [ ! -f $LAB/src/setup.sh ]; then
  echo "lab/ is not in s3://${bucket}/lab/ yet. Run ops/up.sh and reboot." >&2
  exit 0
fi
exec bash $LAB/src/setup.sh
--==BOUNDARY==--
