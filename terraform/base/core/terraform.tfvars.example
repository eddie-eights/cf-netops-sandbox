# Copy to terraform.tfvars only when the defaults are not right. Every value has a default in variables.tf.
# ops/up.sh passes owner (and vpc_cidr / client_cidr when set) with -var. The agent settings moved to terraform/agent.
#
# region      = "ap-northeast-1"
# name_prefix = "netops-poc"
# owner       = "netops"
#
# vpc_cidr    = "10.0.0.0/16"
# az_id_a     = "apne1-az1"
# az_id_b     = "apne1-az4"
# client_cidr = ""                 # corporate CIDR that reaches the ssm / ssmmessages endpoints over DX or VPN
#
# instance_type     = "t4g.small"
# ami_ssm_parameter = "/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-arm64"
#
# create_ssm_endpoints       = true
# create_s3_gateway_endpoint = true
# create_shared_endpoints    = true  # ecr.api / ecr.dkr / logs (2 AZ)
