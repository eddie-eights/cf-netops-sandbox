# netops-poc の**実行時**の環境変数の一覧（Web / エージェント / ワーカー / ツール / lab）。
#
# deploy.env.example との違い:
#   .env.example        ここ。**動いているプログラムが読む値**（リージョン・表の名前・タイトルなど）。
#                       AWS 上では手で用意しない。Terraform が systemd の EnvironmentFile や
#                       コンテナ・Lambda の環境変数として渡す。手元で Web を動かすときだけ .env に写して使う。
#   deploy.env.example  ops/up.sh / ops/down.sh が読む「**何を作るか**」の設定（AGENT / PIPELINE / WORKFLOW、
#                       接頭辞、イメージのタグなど）。Terraform に渡す変数であって、アプリは読まない。
#
# **.env が無くても動く。**下の「既定」がコード側に書いてあり、.env はそれを上書きするだけ。
# 既定が無いのは 2 つだけで、AWS_REGION（Web。無いと起動時に止まる）と MODEL_ID（エージェント。無いと起動時に止まる）。
# **この見本の値 = 既定とは限らない。**違うものには「既定 …」を別に書いてある（DATA_DIR と PARAM_PREFIX）。
#
# 誰が入れるか:
#   Web の EC2          terraform/base/core の user_data が /etc/<接頭辞>-web.env に書く（systemd の EnvironmentFile）
#   エージェント        terraform/agent の AgentCore Runtime の environment_variables
#   ワーカー            terraform/workflow の ECS タスク定義（worker コンテナ）
#   tools Lambda        terraform/workflow/gateway.tf
#   lab の EC2          terraform/pipeline/lab の user_data が /etc/<接頭辞>-lab.env に書く
# EC2 で Web が立たないときは、この並びと /etc/<接頭辞>-web.env を見比べる。
#
# 手元で Web を動かすとき（docs/development.md「Web を手元で動かす」）:
#   cp .env.example .env
# 読むのは web/config.py で、展開したフォルダ直下の .env を見る（ENV_FILE=<パス> で場所を変えられる）。
# 既にある環境変数は上書きしない。同じ名前が 2 回あれば後の行が勝つ。空の値は「未設定」と同じ。
# .env は配布物には入っていない。実際の ARN や ID を書いたファイルを配らない。

# ===== Web（web/*.py。読むのは web/config.py と web/chat.py）。EC2 では systemd の EnvironmentFile=/etc/<接頭辞>-web.env で渡る =====

# **必須。既定なし。**Runtime / SSM / Neptune を呼ぶリージョン。空だと起動時に止まる
AWS_REGION=ap-northeast-1

# 任意。既定は空。チャットの送り先の AgentCore Runtime の ARN（terraform/agent の出力 agent_runtime_arn）。
# **空でも起動する。**空のときは SSM の <PARAM_PREFIX>/runtime-arn を 60 秒ごとに読み（terraform/agent が書く）、
# そちらも無ければ「チャット」タブだけがエラーになる（トポロジ・異常一覧・承認は動く）。
# EC2 では書かない（SSM から読むので、agent を作り直しても EC2 を作り直さずに済む）
RUNTIME_ARN=

# 任意。既定 8080。待ち受けポート（127.0.0.1 だけ）。
# ポートフォワーディングの portNumber と同じ値（docs/deploy.md「利用者に画面を渡す」）
PORT=8080

# 任意。既定 NetOps PoC。画面のタイトル
TITLE=NetOps PoC

# 任意。静的トポロジ（devices.yaml / topology.json）の場所。相対パスは展開したフォルダ直下からたどる。
# **既定は web/data**（EC2 が S3 の web/data/ を取る先。user_data は絶対パスで書く）。
# 手元には web/data が無いので、下の行で agent/data を指している
DATA_DIR=agent/data

# 任意。**既定は空。**Terraform が SSM に書くパラメータの接頭辞
# （<接頭辞>/runtime-arn、<接頭辞>/neptune-endpoint）。異常と修復案も Neptune の頂点なので、neptune-endpoint だけで「異常一覧」と「承認」も動く。
# 値は接頭辞に / を付けたもの（接頭辞は deploy.env の OWNER から作る <owner>-nwc-poc）。空なら SSM を引かず、
# チャットと異常一覧と承認は「未配備」、トポロジは静的データだけで動く。EC2 では user_data が /<接頭辞> を書く。
# 手元で SSM を引くなら /<接頭辞> を書く
PARAM_PREFIX=

# 任意。既定は空（= PARAM_PREFIX 経由で SSM から引く）。SSM を引かずに直接指すとき（テスト用）。通常は空のまま
NEPTUNE_ENDPOINT=

# 任意。既定 60。トポロジを Neptune から引き直す間隔（秒）
TOPOLOGY_TTL=60

# 任意。Gradio と Hugging Face のテレメトリを止める（どれも既定は「送る」）。
# EC2 はインターネットに出ないので送れずに待たされる。手元でも SSL インスペクションで待たされるので止める
GRADIO_ANALYTICS_ENABLED=False
HF_HUB_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1

# EC2 だけ（user_data が書く。手元では要らない）
#   PYTHONPATH=/opt/<接頭辞>-web/lib            pip install --target で入れた依存の場所
#   GRADIO_TEMP_DIR=/var/lib/<接頭辞>-web/tmp   systemd の StateDirectory（DynamicUser なので他は書けない）

# ===== エージェント（agent/app.py）。terraform/agent の AgentCore Runtime の環境変数が渡す。
# EC2 では使わない。EC2 の journald に KeyError: 'MODEL_ID' が出たら、S3 の web/app.py に agent/app.py を置いている
# （docs/architecture.md「どのファイルがどこで動くか」） =====
# 手元では tests/test_app.py が自分で入れるので .env に書く必要は無い（参考として並べる）
#   MODEL_ID=                      **必須。既定なし**（無いと起動時に KeyError）。Converse に渡すモデル ID（変数 model_id）
#   BEDROCK_REGION=ap-northeast-1  既定 ap-northeast-1
#   KNOWLEDGE_BASE_ID=             既定は空。空なら Retrieve を飛ばし、モデルとツールだけで答える（CREATE_KB=0 のとき）
#   NUMBER_OF_RESULTS=5            既定 5。検索の件数（変数 number_of_results）
#   RERANK_MODEL_ARN=              既定は空。空ならリランクしない
#   NUMBER_OF_RERANKED_RESULTS=5   既定 5
#   GUARDRAIL_ID=                  既定は空（= ガードレールを通さない）。出力 guardrail_id
#   GUARDRAIL_VERSION=DRAFT        既定 DRAFT。出力 guardrail_version
#   MAX_TOKENS=1024                既定 1024
#   MAX_TURNS=10                   既定 10。履歴に残す往復の数
#   MAX_TOOL_ROUNDS=5              既定 5。ツールの往復の上限
#   PARAM_PREFIX=                  既定は空。Web と同じ
#   TOPOLOGY_DATA_DIR=             既定は agent/data（イメージに同梱）。静的トポロジの場所
#   TOPOLOGY_TTL=60                既定 60
#   GATEWAY_URL=                   既定は空（= SSM の <接頭辞>/gateway-url を引く。それも無ければコンテナの中のツールで答える）
#   GATEWAY_TTL=300                既定 300。Gateway の URL を SSM から引き直す間隔（秒）
#   GATEWAY_TIMEOUT=30             既定 30。MCP の tools/list・tools/call のタイムアウト（秒）

# ===== ツール（tools/handler.py）。terraform/workflow/gateway.tf の Lambda の環境変数が渡す =====
# agent/ のモジュールをそのまま使うので、名前と既定はエージェント側と同じ。ここだけのものは 3 つ
#   OPENSEARCH_ENDPOINT=           既定は空（= search_logs は「配備されていない」を返す）。SINK_OPENSEARCH=1 のときだけ入る
#   OPENSEARCH_INDEX=snmp-logs     既定 snmp-logs
#   PROMETHEUS_QUERY_URL=          既定は空（= query_metrics は「配備されていない」を返す）。SINK_PROMETHEUS=1 のときだけ入る

# ===== ワーカー（workflow/worker.py と workflow/awsio.py）。terraform/workflow の ECS タスク定義が渡す =====
# 手元では tests/test_workflow.py が差し替えるので .env に書く必要は無い（参考として並べる）
#   NEPTUNE_ENDPOINT=              **必須。既定は空**（空なら起動時に止まる）。異常と修復案の「いま」を読み書きする Neptune（host:8182。terraform/pipeline/graph）
#   AUDIT_TABLE_BUCKET_ARN=        **必須。既定は空**（空なら起動時に止まる）。修復案の証跡を書く S3 Tables のバケット（terraform/pipeline/analytics）
#   AUDIT_NAMESPACE=               **必須。既定は空**（空なら起動時に止まる）。その namespace
#   PROPOSAL_EVENTS_TABLE=proposal_events  既定 proposal_events
#   AGENT_RUNTIME_ARN=             **必須。既定は空**（空なら起動時に止まる）。調査を投げる AgentCore Runtime
#   ANOMALY_QUEUE_URL=             既定は空。空なら SQS を使わず、Neptune の open の異常を POLL_INTERVAL 秒ごとに見る
#   LAB_INSTANCE_ID=               既定は空。空なら承認しても SSM Run Command を打たず、修復のアクティビティが Skipped を返す
#   AWS_REGION=ap-northeast-1      既定 ap-northeast-1
#   TEMPORAL_ADDRESS=localhost:7233  既定 localhost:7233（同じタスクの temporal コンテナ）
#   TASK_QUEUE=netops-investigate  既定 netops-investigate
#   POLL_INTERVAL=60               既定 60。SQS が無いときに Neptune の open の異常を見る間隔（秒）
#   APPROVAL_TIMEOUT_MINUTES=120   既定 120。承認待ちのまま expired にするまでの分数
#   VERIFY_ATTEMPTS=6              既定 6。修復後に resolved を確かめる回数
#   VERIFY_INTERVAL=30             既定 30。その間隔（秒）
#   DECISION_POLL=30               既定 30。承認タブの決定を見に行く間隔（秒）

# ===== lab（lab/lab.sh）。terraform/pipeline/lab の user_data が /etc/<接頭辞>-lab.env に書き、lab.sh が読む =====
# Telegraf の EC2（telegraf/telegraf.sh）は /etc/<接頭辞>-telegraf.env に AWS_REGION と PARAM_PREFIX だけを書く
# どれも Terraform が値を埋める。手元では使わない
#   AWS_REGION=ap-northeast-1
#   REGISTRY=<アカウント ID>.dkr.ecr.<リージョン>.amazonaws.com   ECR（terraform/pipeline/lab が埋める）
#   FRR_IMAGE=<REGISTRY>/<接頭辞>-lab-frr:<frr_image_tag>
#   SNMPD_IMAGE=<REGISTRY>/<接頭辞>-lab-snmpd:<snmpd_image_tag>
#   MULTITOOL_IMAGE=<REGISTRY>/<接頭辞>-lab-multitool:<multitool_image_tag>
#   PARAM_PREFIX=/<接頭辞>   lab.sh forward が <接頭辞>/telegraf-address を、Telegraf が <接頭辞>/msk-bootstrap を読む
