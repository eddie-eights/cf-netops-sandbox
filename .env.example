# fukuda-nwc-poc が読む環境変数の一覧（Web / エージェント / lab）。
#
# AWS 上では手で用意しない。Web の EC2 は terraform/base/core の user_data が /etc/fukuda-nwc-poc-web.env に書き、
# エージェントのコンテナは terraform/base/core の AgentCore Runtime が渡し、lab の EC2 は terraform/pipeline/lab の user_data が
# /etc/fukuda-nwc-poc-lab.env に書く。EC2 で Web が立たないときは、この並びと /etc/fukuda-nwc-poc-web.env を見比べる。
#
# 手元で web/app.py を動かすとき（README「Web を手元で動かす」）:
#   cp .env.example .env
# して RUNTIME_ARN を埋める。web/app.py はリポジトリ直下の .env を読む（ENV_FILE=<パス> で場所を変えられる）。
# 既にある環境変数は上書きしない。同じ名前が 2 回あれば後の行が勝つ。空の値は「未設定」と同じ。
# .env は gitignore 済み。実際の ARN や ID を書いたファイルをコミットしない。

# ===== Web（web/app.py）。EC2 では systemd の EnvironmentFile=/etc/fukuda-nwc-poc-web.env で渡る =====

# 必須。チャットの送り先の AgentCore Runtime の ARN。terraform/base/core の出力 agent_runtime_arn。空だと起動時に止まる
RUNTIME_ARN=

# 必須。Runtime / SSM / DynamoDB を呼ぶリージョン。空だと起動時に止まる
AWS_REGION=ap-northeast-1

# 待ち受けポート（127.0.0.1 だけ）。README 手順 7 のポートフォワーディングの portNumber と同じ値
PORT=8080

# 画面のタイトル
TITLE=NWC PoC

# 静的トポロジ（devices.yaml / topology.json）の場所。EC2 では S3 の web/data/ を取った /opt/fukuda-nwc-poc-web/src/data。
# 手元では agent/data（相対パスはリポジトリ直下から）
DATA_DIR=agent/data

# terraform/pipeline/stream / terraform/pipeline/graph が SSM に書くパラメータの接頭辞（<接頭辞>/anomaly-table、<接頭辞>/neptune-endpoint）。
# 空なら SSM を引かず、異常一覧は「未配備」、トポロジは静的データだけで動く
PARAM_PREFIX=/fukuda-nwc-poc

# 任意。SSM を引かずに直接指す（テスト用）。通常は空のまま
ANOMALY_TABLE=
NEPTUNE_ENDPOINT=

# 任意。トポロジを Neptune から引き直す間隔（秒）
TOPOLOGY_TTL=60

# Gradio のテレメトリを止める（EC2 はインターネットに出ない。手元でも SSL インスペクションで待たされるので止める）
GRADIO_ANALYTICS_ENABLED=False
HF_HUB_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1

# EC2 だけ（user_data が書く。手元では要らない）
#   PYTHONPATH=/opt/fukuda-nwc-poc-web/lib          pip install --target で入れた依存の場所
#   GRADIO_TEMP_DIR=/var/lib/fukuda-nwc-poc-web/tmp  systemd の StateDirectory（DynamicUser なので他は書けない）

# ===== エージェント（agent/app.py）。terraform/base/core の AgentCore Runtime の環境変数が渡す。
# EC2 では使わない。EC2 の journald に KeyError: 'MODEL_ID' が出たら、S3 の web/app.py に agent/app.py を置いている（README「どのファイルがどこで動くか」） =====
# 手元では tests/test_app.py が自分で入れるので、ここに書く必要は無い（参考として並べる）
#   MODEL_ID=                    必須。Converse に渡すモデル ID（変数 model_id）
#   KNOWLEDGE_BASE_ID=           必須。ナレッジベース ID（出力 knowledge_base_id）
#   BEDROCK_REGION=ap-northeast-1
#   NUMBER_OF_RESULTS=5          検索の件数（変数 number_of_results）
#   RERANK_MODEL_ARN=            リランクのモデル ARN。空ならリランクしない
#   NUMBER_OF_RERANKED_RESULTS=5
#   GUARDRAIL_ID=                出力 guardrail_id
#   GUARDRAIL_VERSION=DRAFT      出力 guardrail_version
#   MAX_TOKENS=1024
#   MAX_TURNS=10
#   MAX_TOOL_ROUNDS=5
#   PARAM_PREFIX=/fukuda-nwc-poc  Web と同じ
#   TOPOLOGY_DATA_DIR=           静的トポロジの場所。空なら agent/data（イメージに同梱）

# ===== lab（lab/lab.sh）。terraform/pipeline/lab の user_data が /etc/fukuda-nwc-poc-lab.env に書き、lab.sh と Telegraf の unit が読む =====
#   AWS_REGION=ap-northeast-1
#   REGISTRY=123456789012.dkr.ecr.ap-northeast-1.amazonaws.com   ECR（アカウント ID は terraform/pipeline/lab が埋める）
#   FRR_IMAGE=<REGISTRY>/fukuda-nwc-poc-lab-frr:<frr_image_tag>
#   SNMPD_IMAGE=<REGISTRY>/fukuda-nwc-poc-lab-snmpd:<snmpd_image_tag>
#   MULTITOOL_IMAGE=<REGISTRY>/fukuda-nwc-poc-lab-multitool:<multitool_image_tag>
#   PARAM_PREFIX=/fukuda-nwc-poc  Telegraf が <接頭辞>/msk-bootstrap を読む
