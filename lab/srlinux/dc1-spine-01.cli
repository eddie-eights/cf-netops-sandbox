set / system name host-name dc1-spine-01
set / interface ethernet-1/1 description "fabric to dc1-leafsw-01 25G"
set / interface ethernet-1/1 admin-state enable
set / interface ethernet-1/1 subinterface 0 admin-state enable
set / interface ethernet-1/1 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/1 subinterface 0 ipv4 address 172.16.0.0/31
set / interface ethernet-1/2 description "fabric to dc1-leafsw-02 25G"
set / interface ethernet-1/2 admin-state enable
set / interface ethernet-1/2 subinterface 0 admin-state enable
set / interface ethernet-1/2 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/2 subinterface 0 ipv4 address 172.16.0.2/31
set / interface ethernet-1/3 description "fabric to dc1-leaf-01 25G"
set / interface ethernet-1/3 admin-state enable
set / interface ethernet-1/3 subinterface 0 admin-state enable
set / interface ethernet-1/3 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/3 subinterface 0 ipv4 address 172.16.0.4/31
set / interface ethernet-1/4 description "fabric to dc1-leaf-02 25G"
set / interface ethernet-1/4 admin-state enable
set / interface ethernet-1/4 subinterface 0 admin-state enable
set / interface ethernet-1/4 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/4 subinterface 0 ipv4 address 172.16.0.6/31
set / interface system0 admin-state enable
set / interface system0 subinterface 0 admin-state enable
set / interface system0 subinterface 0 ipv4 admin-state enable
set / interface system0 subinterface 0 ipv4 address 10.255.0.1/32
set / network-instance default type default
set / network-instance default interface ethernet-1/1.0
set / network-instance default interface ethernet-1/2.0
set / network-instance default interface ethernet-1/3.0
set / network-instance default interface ethernet-1/4.0
set / network-instance default interface system0.0
set / network-instance default protocols isis instance main admin-state enable
set / network-instance default protocols isis instance main level-capability L2
set / network-instance default protocols isis instance main net [ 49.0001.0000.0000.0021.00 ]
set / network-instance default protocols isis instance main ipv4-unicast admin-state enable
set / network-instance default protocols isis instance main interface ethernet-1/1.0 circuit-type point-to-point
set / network-instance default protocols isis instance main interface ethernet-1/1.0 ipv4-unicast admin-state enable
set / network-instance default protocols isis instance main interface ethernet-1/2.0 circuit-type point-to-point
set / network-instance default protocols isis instance main interface ethernet-1/2.0 ipv4-unicast admin-state enable
set / network-instance default protocols isis instance main interface ethernet-1/3.0 circuit-type point-to-point
set / network-instance default protocols isis instance main interface ethernet-1/3.0 ipv4-unicast admin-state enable
set / network-instance default protocols isis instance main interface ethernet-1/4.0 circuit-type point-to-point
set / network-instance default protocols isis instance main interface ethernet-1/4.0 ipv4-unicast admin-state enable
set / network-instance default protocols isis instance main interface system0.0 passive true
set / network-instance default protocols isis instance main interface system0.0 ipv4-unicast admin-state enable
set / network-instance default protocols bgp autonomous-system 65100
set / network-instance default protocols bgp router-id 10.255.0.1
set / network-instance default protocols bgp afi-safi evpn admin-state enable
set / network-instance default protocols bgp afi-safi ipv4-unicast admin-state disable
set / network-instance default protocols bgp group overlay peer-as 65100
set / network-instance default protocols bgp group overlay afi-safi evpn admin-state enable
set / network-instance default protocols bgp group overlay afi-safi ipv4-unicast admin-state disable
set / network-instance default protocols bgp group overlay transport local-address 10.255.0.1
set / network-instance default protocols bgp group overlay timers keepalive-interval 10
set / network-instance default protocols bgp group overlay timers hold-time 30
set / network-instance default protocols bgp group overlay route-reflector client true
set / network-instance default protocols bgp group overlay route-reflector cluster-id 10.255.0.1
set / network-instance default protocols bgp neighbor 10.255.1.1 peer-group overlay
set / network-instance default protocols bgp neighbor 10.255.1.1 description "dc1-leafsw-01"
set / network-instance default protocols bgp neighbor 10.255.1.2 peer-group overlay
set / network-instance default protocols bgp neighbor 10.255.1.2 description "dc1-leafsw-02"
set / network-instance default protocols bgp neighbor 10.255.2.1 peer-group overlay
set / network-instance default protocols bgp neighbor 10.255.2.1 description "dc1-leaf-01"
set / network-instance default protocols bgp neighbor 10.255.2.2 peer-group overlay
set / network-instance default protocols bgp neighbor 10.255.2.2 description "dc1-leaf-02"
set / system snmp network-instance mgmt admin-state enable
set / system snmp trap-group telegraf admin-state enable
set / system snmp trap-group telegraf network-instance mgmt
set / system snmp trap-group telegraf destination telegraf admin-state enable
set / system snmp trap-group telegraf destination telegraf address 203.0.113.1
set / system snmp trap-group telegraf destination telegraf security-level no-auth-no-priv
set / system snmp trap-group telegraf destination telegraf community-entry public community public
set / system logging network-instance mgmt
set / system logging remote-server 203.0.113.1 transport udp
set / system logging remote-server 203.0.113.1 remote-port 5140
set / system logging remote-server 203.0.113.1 subsystem bgp priority match-above informational
set / system logging remote-server 203.0.113.1 subsystem chassis priority match-above informational
set / system logging remote-server 203.0.113.1 subsystem evpn priority match-above informational
set / system logging remote-server 203.0.113.1 subsystem isis priority match-above informational
set / system logging remote-server 203.0.113.1 subsystem lag priority match-above informational
set / system logging remote-server 203.0.113.1 subsystem linux priority match-above informational
set / system logging remote-server 203.0.113.1 subsystem netinst priority match-above informational
set / system logging remote-server 203.0.113.1 subsystem xdp priority match-above informational
