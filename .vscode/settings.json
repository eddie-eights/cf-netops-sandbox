// このリポジトリを開いたときだけ効く設定。手元の PC の好みはここに入れず、
// ユーザー設定（docs/vscode/user-settings.json）に入れる。
{
  // シェルスクリプトと user_data は LF でないと EC2 で動かない
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  // Markdown は行末の 2 個の空白が改行なので消さない
  "[markdown]": {
    "files.trimTrailingWhitespace": false
  },

  // 保存で terraform fmt がかかる。ops/check 相当の fmt -check と食い違わないようにするため
  "[terraform]": {
    "editor.defaultFormatter": "hashicorp.terraform",
    "editor.formatOnSave": true
  },
  "[terraform-vars]": {
    "editor.defaultFormatter": "hashicorp.terraform",
    "editor.formatOnSave": true
  },

  // 拡張子だけでは言語が決まらないファイル
  "files.associations": {
    "*.sh.tftpl": "shellscript",
    "**/telegraf.conf.in": "toml",
    "**/*.clab.yml.in": "yaml",
    "buildspec.yml": "yaml"
  },

  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.analysis.typeCheckingMode": "basic",

  // 検索とファイル監視から外す（.terraform は依存プラグインで数万ファイルになる）
  "search.exclude": {
    "**/.terraform": true,
    "**/.venv": true,
    "**/__pycache__": true,
    "**/wheels": true,
    "**/uv.lock": true,
    "**/*.zip": true
  },
  "files.watcherExclude": {
    "**/.terraform/**": true,
    "**/.venv/**": true,
    "**/__pycache__/**": true
  }
}
